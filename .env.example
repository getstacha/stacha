# Copy to .env. Keep API keys and PayPal secrets private.
NEBIUS_API_KEY=
NEBIUS_MODEL=nvidia/Nemotron-3_5-Lightning
# Optional model used only when a buyer requests refinement.
NEBIUS_REFINEMENT_MODEL=deepseek-ai/DeepSeek-V4-Pro
CHANNEL3_API_KEY=
# Sandbox credentials only. The application uses PayPal's sandbox endpoint exclusively.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Required for verification of events sent to /api/paypal/webhook.
PAYPAL_WEBHOOK_ID=
PAYPAL_DEMO_MERCHANT=Configured sandbox merchant
# Optional: independently pin the expected sandbox business account merchant ID.
PAYPAL_SANDBOX_MERCHANT_ID=
# Poll due repeating projects while the local server is running; no automatic payment.
SCHEDULER_ENABLED=true
# The gateway listens on localhost; publish only its webhook path through HTTPS.
PAYPAL_WEBHOOK_PORT=3100
# Optional local SQLite paths for event delivery and immutable financial-event history.
# PAYPAL_WEBHOOK_QUEUE=/absolute/path/webhook-queue.sqlite3
# PAYPAL_FINANCIAL_LEDGER=/absolute/path/financial-events.sqlite3

# Optional: override owner password-hash file (never put a plaintext password here).
# STACHA_AUTH_FILE=/absolute/path/owner-auth.json
# Optional webhook gateway shared secret, minimum 32 random characters; keep private.
# STACHA_WEBHOOK_SECRET=

# Optional buyer-side local merchant bridge settings. The seller service has its
# own MERCHANT_PORT / MERCHANT_STATE_FILE / MERCHANT_UI_PASSWORD_FILE environment.
# MERCHANT_BRIDGE_PORT=3217
# MERCHANT_BRIDGE_KEY_FILE=/absolute/path/merchant-bridge.key
# MERCHANT_MONITOR_ENABLED=true

# Optional Resend email integration; never commit credentials.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Domain configured for receiving mail, without a username or @.
RESEND_INBOUND_DOMAIN=
# Poll only while the application is running.
RESEND_SYNC_ENABLED=true

# Optional sandbox invoicing. Disabled unless account access and merchant identity are verified.
PAYPAL_INVOICING_ENABLED=false
PAYPAL_INVOICE_ACCOUNT_EMAIL=
# Set true only after independently checking the ID and email on the same sandbox business account.
PAYPAL_INVOICE_IDENTITY_CONFIRMED=false

# Optional supplier-only HTTPS gateway; do not expose the owner application.
# STACHA_PORTAL_PUBLIC_ORIGIN=https://portal.example.com
# STACHA_PORTAL_GATEWAY_PORT=3221
# STACHA_PORTAL_CORE_PORT=3000
